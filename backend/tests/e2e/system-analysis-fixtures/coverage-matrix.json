    {
      "id": "facts_and_acknowledgements",
      "testFile": "src/agentRuntime/__tests__/analysisInvestigationRequirements.test.ts",
      "testTitle": "exempts %s without an evidence scan",
      "boundary": "Resolved fact/ack are exempt; configuration coverage is not an observation."
    },
    {
      "id": "existing_only",
      "testFile": "src/agentRuntime/__tests__/runtimeTurnPolicy.test.ts",
      "testTitle": "never prefetches for existing_only with %s budget",
      "boundary": "All budgets retain existing_only with no evidence prefetch."
    },
    {
      "id": "ledger_acquisition",
      "testFile": "src/services/__tests__/ledgerAcquisitionGate.test.ts",
      "testTitle": "does not claim coverage when the ledger truncated records",
      "boundary": "Acquisition is read from the ledger alone; truncated or missing records never read as observed."
    },
    {
      "id": "saved_results",
      "testFile": "src/services/__tests__/comparisonAiConclusionService.test.ts",
      "testTitle": "keeps saved producer rows out of the bounded prompt without losing the stored matrix",
      "boundary": "Snapshot comparison retains stored investigation state; prompt excludes raw rows, no trace backfill."
    },
    {
      "id": "historical_restore",
      "testFile": "src/services/__tests__/finalizeAnalysisResult.test.ts",
      "testTitle": "keeps the stored verdicts, assurance and report presentation unchanged",
      "boundary": "Stored verdicts and assurance are read back unchanged; new finalization never rewrites them."
    },
    {
      "id": "native_completion",
      "testFile": "src/services/__tests__/finalizeAnalysisResult.test.ts",
      "testTitle": "does not alter completion, body or termination because of the investigation ledger",
      "boundary": "The investigation ledger is record-only display and cannot rewrite SDK completion."
    },
    {
      "id": "all_scene_configuration",
      "testFile": "src/agentRuntime/__tests__/analysisInvestigationRequirements.test.ts",
      "testTitle": "configures every built-in scene and only expands the selected scene profiles",
      "boundary": "Includes overview/general/teaching and all scene metadata without pretending every scene ran on a device."
    }
  ],
