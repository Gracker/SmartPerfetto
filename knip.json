{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        ".github/workflows/*.yml",
        ".github/dependabot.yml",
        "Dockerfile",
        "docker-compose*.yml",
        "start.sh",
        "scripts/*.sh",
        "Trace/tools/trace-corpus.cjs"
      ],
      "project": [
        "package.json",
        ".github/**/*.yml",
        "Dockerfile",
        "docker-compose*.yml",
        "start.sh",
        "scripts/*.sh",
        "Trace/tools/**/*.cjs"
      ]
    },
    "backend": {
      "entry": [
        "package.json",
        "src/agent/core/conclusionContract.ts!",
        "src/agentRuntime/analysisFinalizationContext.ts!",
        "src/agentRuntime/engines/pi/piAgentCoreProvider.ts!",
        "src/agentRuntime/engines/pi/piAgentCoreRuntime.ts!",
        "src/agentv3/selfImprove/migrateFailureModeHash.ts!",
        "src/agentv3/selfImprove/promoteSkillNote.ts!",
        "src/cli-user/bin.ts!",
        "src/cli/index.ts!",
        "src/index.ts!",
        "src/scripts/auditAndroidInternalsWiki.ts!",
        "src/scripts/auditTraceProcessorRssMatrix.ts!",
        "src/scripts/benchmarkAgentRuntimeLatency.ts!",
        "src/scripts/benchmarkTraceProcessorRss.ts!",
        "src/scripts/captureContextEngineeringBaseline.ts!",
        "src/scripts/checkProviderModelCatalog.ts!",
        "src/scripts/enterpriseAcceptanceLoadTest.ts!",
        "src/scripts/enterpriseMigrationSnapshot.ts!",
        "src/scripts/enterpriseReadinessAudit.ts!",
        "src/scripts/materializeRenderingPipelineDetectionSkill.ts!",
        "src/scripts/runScrollingTest.ts!",
        "src/scripts/runScrollingTestRealData.ts!",
        "src/scripts/verifyAgentSseScrolling.ts!",
        "src/scripts/verifyAgentSseStopSemantics.ts!",
        "src/scripts/verifyCodeAwareSemanticDelta.ts!",
        "src/scripts/verifyTraceAnchorLocatorHpfc.ts!",
        "src/scripts/verifyEnterpriseMultiTenantWindows.ts!",
        "src/services/canonicalAnalysisResult.ts!",
        "src/services/resolvedAnalysisContext.ts!",
        "src/services/scopedKnowledgeStore.ts!",
        "src/services/selfEvolution/feedbackMigrationCli.ts!",
        "src/services/traceProcessorSqlWorkerThread.ts!",
        "src/types/claimVerification.ts!",
        "src/types/criticalPathContract.ts!",
        "src/types/dataContract.ts!",
        "src/types/evidenceContract.ts!",
        "src/types/externalIssueReporting.ts!",
        "src/types/identityContract.ts!",
        "scripts/**/*.ts!",
        "src/**/*.test.ts",
        "src/**/__tests__/**/*.ts",
        "tests/**/*.ts"
      ],
      "project": ["package.json", "src/**/*.ts!", "tests/**/*.ts", "scripts/**/*.ts!"],
      "ignoreDependencies": ["@earendil-works/pi-agent-core", "@qoder-ai/qoder-agent-sdk", "jest", "tsx"],
      "ignoreBinaries": ["jest", "pgrep", "ps", "secret-tool", "sqlite3", "tsx"],
      "ignoreUnresolved": ["/usr/bin/security"]
    }
  },
  "ignore": [
    "frontend/**",
    "perfetto/**",
    "docs/**",
    "backend/public/**",
    "backend/skills/**",
    "backend/strategies/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/*"],
  "ignoreBinaries": ["lsof", "pgrep", "ps", "shellcheck", "tsc"]
}
